# ─────────────────────────────────────────────────────────────
# Ministry Training Platform — environment variables (EXAMPLE)
# Copy to .env and fill in. NEVER commit the real .env.
#   cp .env.example .env
# The API validates this file at boot (apps/api/src/config/env.schema.ts) and
# refuses to start on anything malformed.
# ─────────────────────────────────────────────────────────────

# ---- App ----
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
DEFAULT_LOCALE=ar
# Digits: "western" (0-9, default) or "arabic-indic" (٠-٩)  — D-018
NUMBER_FORMAT=western

# Browser-exposed. Must be the public URL of the API. Never put a secret here.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Database (PostgreSQL) ----
# Matches docker-compose.yml: `npm run db:up`
DATABASE_URL=postgresql://user:password@localhost:5432/tamkeen?schema=public

# ---- Redis (BullMQ jobs) ----
REDIS_URL=redis://localhost:6379

# ---- Database seed (super-admin bootstrap) ----
# Leave SEED_SUPER_ADMIN_PASSWORD empty in development: the seed generates a
# random password and prints it once. In production it MUST be set explicitly —
# the seed refuses to run otherwise rather than print a privileged credential
# into a deployment log.
SEED_SUPER_ADMIN_EMAIL=admin@ministry.gov.example
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_EMPLOYEE_ID=ADMIN-0001

# ---- Auth ----
# No JWT/session secret is needed: sessions are opaque 256-bit random tokens
# stored as SHA-256 hashes in the database (D-028), so there is nothing to sign.
#
# Sliding session lifetime in minutes (720 = 12h, roughly one working day).
SESSION_TTL_MINUTES=720
# Registration policy: "restricted" (allowed-domain + employee-ID) or "admin-only"  — D-017
REGISTRATION_MODE=restricted
# Comma-separated allowed email domains for restricted self-registration
ALLOWED_EMAIL_DOMAINS=ministry.gov.example
# Shape of a ministry employee number. Replace with the real format once known.
EMPLOYEE_ID_PATTERN=^[A-Za-z0-9][A-Za-z0-9-]{3,19}$
# Minimum password length. Length beats composition rules (NIST SP 800-63B),
# so there is intentionally no "must contain a symbol" requirement.
PASSWORD_MIN_LENGTH=12
# Global per-IP request ceiling. The stricter limits on the auth endpoints
# themselves are fixed in code — security floors, not operator knobs.
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_MAX_REQUESTS=120
# Per-account brute-force lockout
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Single-use token lifetimes (minutes)
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=60

# ---- Email (SMTP, transactional) ----
# Development: Mailpit from docker-compose (no auth) — inbox at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Tamkeen <no-reply@ministry.gov.example>"

# ---- Moodle integration ----
# Until Phase 2, keep MOODLE_MODE=mock (the real client is not implemented yet).
MOODLE_MODE=mock
MOODLE_BASE_URL=
# Server-side ONLY. Never expose to the browser.
MOODLE_WS_TOKEN=
# Product setting: quiz grade (%) required to earn a certificate.  — D-007
PASS_THRESHOLD=70
# Completion sync interval (minutes) — Phase 2+
COMPLETION_SYNC_INTERVAL_MINUTES=5

# ---- Certificates ----
# Public base URL for the certificate verification page (QR points here).  — D-016
CERT_VERIFICATION_BASE_URL=http://localhost:3000/verify
