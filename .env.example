# ─────────────────────────────────────────────────────────────
# Ministry Training Platform — environment variables (EXAMPLE)
# Copy to .env and fill in. NEVER commit the real .env.
#   cp .env.example .env
# The API validates this file at boot (apps/api/src/config/env.schema.ts) and
# refuses to start on anything malformed.
# ─────────────────────────────────────────────────────────────

# ---- App ----
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
DEFAULT_LOCALE=ar
# Digits: "western" (0-9, default) or "arabic-indic" (٠-٩)  — D-018
NUMBER_FORMAT=western

# Browser-exposed. Must be the public URL of the API. Never put a secret here.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Database (PostgreSQL) ----
# Matches docker-compose.yml: `npm run db:up`
DATABASE_URL=postgresql://user:password@localhost:5432/tamkeen?schema=public

# ---- Redis (BullMQ jobs) ----
REDIS_URL=redis://localhost:6379

# ---- Database seed (super-admin bootstrap) ----
# Leave SEED_SUPER_ADMIN_PASSWORD empty in development: the seed generates a
# random password and prints it once. In production it MUST be set explicitly —
# the seed refuses to run otherwise rather than print a privileged credential
# into a deployment log.
SEED_SUPER_ADMIN_EMAIL=admin@ministry.gov.example
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_EMPLOYEE_ID=ADMIN-0001

# Demo learner account (development convenience; skipped in production unless set).
SEED_STUDENT_EMAIL=student@ministry.gov.example
SEED_STUDENT_PASSWORD=
SEED_STUDENT_EMPLOYEE_ID=EMP-1001

# ---- Auth ----
# No JWT/session secret is needed: sessions are opaque 256-bit random tokens
# stored as SHA-256 hashes in the database (D-028), so there is nothing to sign.
#
# Sliding session lifetime in minutes (720 = 12h, roughly one working day).
SESSION_TTL_MINUTES=720
# Registration policy: "restricted" (allowed-domain + employee-ID) or "admin-only"  — D-017
REGISTRATION_MODE=restricted
# Comma-separated allowed email domains for restricted self-registration
ALLOWED_EMAIL_DOMAINS=ministry.gov.example
# Shape of a ministry employee number. Replace with the real format once known.
EMPLOYEE_ID_PATTERN=^[0-9]{10}$
# Minimum password length. Length beats composition rules (NIST SP 800-63B),
# so there is intentionally no "must contain a symbol" requirement.
PASSWORD_MIN_LENGTH=12
# Global per-IP request ceiling. The stricter limits on the auth endpoints
# themselves are fixed in code — security floors, not operator knobs.
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_MAX_REQUESTS=120
# Per-account brute-force lockout
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Single-use token lifetimes (minutes)
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=60

# ---- Email (SMTP, transactional) ----
# Development: Mailpit from docker-compose (no auth) — inbox at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Tamkeen <no-reply@ministry.gov.example>"

# ---- Moodle integration ----
# `mock` runs the in-memory LMS (tests, and development without a Moodle).
# `real` talks to Moodle over Web Services and then requires BASE_URL + WS_TOKEN,
# which the app refuses to start without.
MOODLE_MODE=mock
MOODLE_BASE_URL=
# Server-side ONLY. Never expose to the browser, never log it.
MOODLE_WS_TOKEN=
# Role granted on enrolment. 5 is the stock id for Student, but role ids are
# per-instance — confirm it against the target Moodle rather than assuming. D-038
MOODLE_STUDENT_ROLE_ID=5
# Role granted to an entity authoring its OWN course (D-060). 3 is the stock id
# for editingteacher. The per-instance caveat above applies more sharply here:
# getting a teaching role wrong hands an outside organisation capabilities
# nobody intended.
MOODLE_TEACHER_ROLE_ID=3
# Category that courses created by an entity are filed under (D-060). Moodle
# requires one and every instance numbers them differently, so confirm this
# against the target Moodle — 1 is a placeholder, not a safe default.
MOODLE_COURSE_CATEGORY_ID=1
# Per-call timeout. Moodle answered in 60-256ms when measured; this is an outage
# detector, not a normal-operation budget.
MOODLE_TIMEOUT_MS=10000
# Shared with the local_tamkeensso Moodle plugin, which verifies the seamless-login
# signature with it. 32+ characters. Server-side ONLY.  — D-044
#   openssl rand -base64 48
MOODLE_SSO_SECRET=
# Handoff lifetime in seconds. This URL reaches the browser, so it is the window
# in which anyone who reads it could become that learner. Max 300.
MOODLE_SSO_TTL_SECONDS=60

# Product setting: quiz grade (%) required to earn a certificate.  — D-007
PASS_THRESHOLD=70
# Path membership rules for a course (TAM-141): at most this many paths, spanning
# at most this many RIASEC letters. Approval "on" makes an entity's membership a
# proposal the admin approves (Phase 5); "off" auto-approves.
COURSE_MAX_PATHS=3
COURSE_MAX_RIASEC_LETTERS=2
PATH_MEMBERSHIP_APPROVAL=off
# Completion sync interval (minutes). The scheduler polls Moodle this often.
COMPLETION_SYNC_INTERVAL_MINUTES=5
# Background sync scheduler (catalogue + enrolment reconciliation + completions).
# Needs REDIS_URL. Never runs under NODE_ENV=test, whatever this says.
SYNC_SCHEDULER_ENABLED=true

# ---- Certificates ----
# Public base URL for the certificate verification page (QR points here).  — D-016
CERT_VERIFICATION_BASE_URL=http://localhost:3000/verify

# Where rendered certificate PDFs are written. Bytes are produced once at issue
# time and never re-rendered, so this is the only copy — back it up.  — Q4
CERT_STORAGE_DIR=./.storage/certificates
