# Normalise line endings so Prettier's `endOfLine: lf` check passes identically
# on Windows dev machines and Linux CI.
* text=auto eol=lf

# Binary assets must never be normalised.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
