// Schema through Phase 3.
//
// Phase 0 added the foundation (users, auth_tokens, sessions, audit_log,
// notifications). Phase 1 added the assessment, paths, courses and the user's
// single chosen path. Phase 2 added `completions`. Phase 3 adds `certificates`
// and `cv_profiles`.
//
// Conventions: models are PascalCase in Prisma and snake_case in Postgres via
// @@map/@map. Primary keys are UUIDs rather than sequential integers so record
// identifiers cannot be enumerated or their volume inferred.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// Prisma 7 no longer accepts `url` here. The migration/CLI connection lives in
// prisma.config.ts, and the runtime client connects through the pg driver
// adapter in src/prisma/prisma.service.ts (D-026).
datasource db {
  provider = "postgresql"
}

/// The three portals of the system (CLAUDE.md §1). Kept in lockstep with
/// USER_ROLES in @tamkeen/types — a test asserts the two never diverge.
enum UserRole {
  EMPLOYEE
  ENTITY
  SUPER_ADMIN
}

enum UserStatus {
  /// Normal, may sign in.
  ACTIVE
  /// Administratively disabled. Retained for audit integrity, cannot sign in.
  SUSPENDED
}

model User {
  id String @id @default(uuid()) @db.Uuid

  email        String @unique
  passwordHash String @map("password_hash")

  fullName   String @map("full_name")
  /// Ministry employee number. Unique, and one half of the restricted
  /// registration gate (D-017).
  employeeId String @unique @map("employee_id")
  department String

  role   UserRole   @default(EMPLOYEE)
  status UserStatus @default(ACTIVE)

  /// Which organisation an ENTITY account acts for (D-063). Null for every other
  /// role, and the scope resolver treats a null on an ENTITY account as a hard
  /// failure rather than as "unscoped" — a half-provisioned entity must see
  /// nothing, not everything (D-062).
  entityId String? @map("entity_id") @db.Uuid
  entity   Entity? @relation(fields: [entityId], references: [id], onDelete: Restrict)

  /// Null until the user follows the verification link. Stored as a timestamp
  /// rather than a boolean so "when" is auditable, not just "whether".
  emailVerifiedAt DateTime? @map("email_verified_at")

  /// The only bridge to Moodle for identity (CLAUDE.md §1). Nullable because
  /// provisioning happens in Phase 2; unique so two users can never be mapped
  /// onto the same Moodle account.
  moodleUserId Int? @unique @map("moodle_user_id")

  /// Brute-force lockout state (§2 security baseline). Per-account, in the
  /// database so a lockout survives a restart and is correct regardless of how
  /// many API instances are running. Per-IP throttling is separate and is held
  /// outside the database (in-process for now, a shared store once the
  /// deployment scales — D-028), so request IPs are not accumulated at rest.
  /// Which digits this person sees (§4.12, D-018).
  ///
  /// Null means "follow the system default", which is what §4C.6 sets — so the
  /// ministry can change the default for everyone and anyone who has expressed
  /// a preference keeps theirs. A per-user *language* is deliberately absent:
  /// the UI is Arabic-only, and a selector offering English would be a control
  /// that does nothing.
  numberFormat String? @map("number_format")

  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  authTokens     AuthToken[]
  sessions       Session[]
  notifications  Notification[]
  completions    Completion[]
  certificates   Certificate[]
  cvProfile      CvProfile?
  auditEvents    AuditLog[]     @relation("AuditActor")
  settingsEdited Setting[]      @relation("SettingEditor")

  /// Every attempt at every instrument, newest wins per `kind` (TAM-147).
  /// RIASEC retakes append (D-033); CEFR allows exactly one ever (D-123), a
  /// database fact via the partial unique index on `assessment_results`
  /// (`WHERE kind = 'CEFR'`) rather than a service-layer convention.
  assessmentResults AssessmentResult[]
  /// At most one — the relation is singular because `UserPath.userId` is unique.
  userPath          UserPath?

  @@index([role])
  @@index([entityId])
  @@map("users")
}

/// Server-side sessions (D-028).
///
/// Opaque random tokens, not JWTs, so a session can be revoked the instant an
/// account is suspended — a stateless token would stay valid until it expired.
/// Only the token's hash is stored, on the same reasoning as AuthToken: a
/// database leak must not yield usable sessions.
///
/// Kept in Postgres rather than Redis so signing in does not depend on a second
/// datastore being healthy, and so Phase 5 can show an administrator the active
/// sessions for an account.
model Session {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique @map("token_hash")

  expiresAt  DateTime  @map("expires_at")
  /// Set on sign-out or administrative revocation; the row is kept so the
  /// session's existence stays visible to an audit.
  revokedAt  DateTime? @map("revoked_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")

  /// Coarse client context, for an administrator spotting a session they do not
  /// recognise. No fingerprinting beyond what a server log would already hold.
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

/// Single-use, expiring tokens for email verification and password reset.
///
/// Only a HASH of the token is stored, never the token itself: a database leak
/// must not hand an attacker working verification or reset links. The raw value
/// exists only in the email that was sent.
model AuthToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")

  /// The address an EMAIL_CHANGE token is for, held here rather than on the
  /// user so an abandoned request leaves nothing behind and `users.email` never
  /// holds an address nobody has proved they can read (§4.12).
  newEmail String? @map("new_email")

  expiresAt  DateTime  @map("expires_at")
  /// Set the moment the token is redeemed, making reuse detectable.
  consumedAt DateTime? @map("consumed_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

/// Who did what, when (§2 security baseline).
///
/// PII discipline: this table records actor and target *identifiers*, never
/// names, emails or free-text about people. `ipAddress` is the one exception and
/// is retained deliberately — without it a brute-force or credential-stuffing
/// investigation is impossible — so it is in scope for the Phase 6 retention
/// policy rather than kept indefinitely by default.
model AuditLog {
  id BigInt @id @default(autoincrement())

  occurredAt DateTime @default(now()) @map("occurred_at")

  /// Stable string code, e.g. AUTH_LOGIN_SUCCEEDED, PATH_CONFIRMED,
  /// CERTIFICATE_ISSUED. A string rather than an enum so appending a new action
  /// in a later phase does not require a schema migration.
  action  String
  outcome AuditOutcome

  /// Null for anonymous or system-originated events, e.g. a sign-in attempt
  /// against an address that does not exist.
  actorUserId String? @map("actor_user_id") @db.Uuid
  actor       User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  ipAddress String? @map("ip_address")

  /// What was acted upon, as a type + id pair so any future entity can be
  /// referenced without a column per relation.
  targetType String? @map("target_type")
  targetId   String? @map("target_id")

  /// Structured, non-PII detail only (e.g. { "reason": "ACCOUNT_LOCKED" }).
  metadata Json?

  @@index([occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_log")
}

/// In-app notifications, kept minimal by §2: a light indicator when a
/// certificate is issued. Nothing more — no marketing, no engagement nagging.
enum NotificationType {
  CERTIFICATE_ISSUED
}

model Notification {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type NotificationType

  /// Identifier of the thing the notification points at (a certificate id in
  /// Phase 3). No copy is stored: the Arabic text is rendered from the message
  /// catalogue at read time, so wording changes do not require a data migration.
  relatedId String? @map("related_id")

  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 1 — assessment, paths, courses, and the user's one path
// ─────────────────────────────────────────────────────────────────────────────

/// The six Holland dimensions (CLAUDE.md §3A). Kept in lockstep with
/// RIASEC_LETTERS in @tamkeen/types — a test asserts the two never diverge.
enum RiasecDimension {
  R
  I
  A
  S
  E
  C
}

/// A course's *effective* visibility in our catalogue — derived, never authored.
///
/// Phase 4 stopped anything writing this directly (D-059). It is computed by
/// `effectiveCourseStatus` from three inputs that each have exactly one writer:
/// our `publication` (the entity's decision), and `lmsVisible` / `lmsPresent`
/// (the LMS's facts), plus whether any learner holds the course. Before that
/// split, a sync run recomputed this column from the LMS's `visible` flag and so
/// silently undid an entity's decision to hide a course.
///
/// HIDDEN_BUT_COMPLETABLE is the rule from §2/D-015 that stops content being
/// pulled out from under a learner: a course inside someone's path may leave the
/// catalogue for new selections while enrolled users finish it. The derivation
/// makes that structural — no combination of inputs hides a held course from the
/// learner holding it.
///
/// DRAFT is invisible to learners exactly as RETIRED is, but *reversibly*: it is
/// where a course sits between its Moodle shell being created and its product
/// metadata being finished. RETIRED is an end state and could not serve.
enum CourseStatus {
  DRAFT
  AVAILABLE
  HIDDEN_BUT_COMPLETABLE
  RETIRED
}

/// The entity's publishing decision (D-059). **Ours**, never written by
/// catalogue sync, which reads it only as an input to the derivation above.
///
/// This column is what makes course-edit protection durable: an entity that
/// unpublishes a course records it here, where no LMS signal can reach it.
enum CoursePublication {
  /// Shell exists in the LMS; product metadata incomplete. Not in the catalogue.
  DRAFT
  /// The entity has published it. Whether learners can see it now additionally
  /// depends on the LMS still holding and showing it.
  PUBLISHED
  /// Withdrawn by the entity. Degrades to HIDDEN_BUT_COMPLETABLE rather than
  /// RETIRED while any learner still holds it — §2/D-015.
  UNPUBLISHED
}

/// The language a course was authored in (D-047).
///
/// A course exists in ONE language as its entity wrote it; we do not require or
/// maintain a bilingual title and summary per course. Recorded because the app
/// chrome is Arabic-first and RTL: an English title rendered inside an RTL
/// container needs `dir="ltr"` on that element or its punctuation migrates.
/// So this is not decoration — it is what stops the catalogue mangling text.
enum CourseLanguage {
  AR
  EN
}

/// Whether an entity account may still act (D-063).
enum EntityStatus {
  ACTIVE
  SUSPENDED
}

/// BUILDING is a distinct state from ACTIVE because selecting courses is
/// reversible and confirming is not. Collapsing them would make the hard
/// commitment gate (D-002) a UI convention rather than a data fact.
enum UserPathStatus {
  BUILDING
  ACTIVE
  COMPLETED
}

enum UserPathCourseStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

/// A product knob an administrator may change without a deployment (§4C.6).
///
/// **Key-value, deliberately, and this is the one place that shape is right.**
/// Everywhere else in this schema a fact gets a typed column, because a column
/// is what makes the database able to refuse nonsense. Settings are different in
/// kind: the set of them changes with the product rather than with the data, and
/// a table with one column per knob would need a migration every time the
/// ministry wanted a new one — which is exactly the deployment §4C.6 exists to
/// avoid.
///
/// What replaces the column's typing is `SettingsService`: every value is parsed
/// and validated against the same Zod schema the environment is, so a malformed
/// row is refused on write and falls back to the environment on read rather than
/// reaching a consumer as a string.
///
/// **Secrets are not here.** The Moodle web-services token, the database URL and
/// the SMTP credentials stay environment-only (D-072): a setting readable by the
/// screen that edits it is a setting that appears in a network response.
model Setting {
  /// Matches the environment variable it overrides, e.g. `PASS_THRESHOLD`, so
  /// the two are obviously the same knob when read side by side.
  key   String @id
  value String

  /// Who changed it last. `SetNull` rather than Cascade: the setting outlives
  /// the account, and the audit log carries the full history regardless.
  updatedByUserId String? @map("updated_by_user_id") @db.Uuid
  updatedBy       User?   @relation("SettingEditor", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

/// Which instrument an `Assessment` row is (TAM-147).
///
/// A discriminator, not a second table per instrument — `english-assessment`
/// (TAM-148) proved the opposite call first, splitting Holland and CEFR into
/// sibling tables specifically so `findFirst({ status: 'ACTIVE' })` could not
/// return the wrong instrument's row (D-124). That reasoning holds only while
/// there are two instruments and every "active assessment" query is written by
/// hand; a *framework* — several instruments, assignable by an admin to
/// everyone, a department or a person — needs one registry that can be
/// enumerated, or "which instruments exist" becomes a query over N tables that
/// grows with every instrument added. `kind` is what keeps `findFirst`-style
/// queries correct here: every one of them now filters on it, never on
/// `status` alone.
enum AssessmentKind {
  RIASEC
  CEFR
}

/// Where a version of the assessment sits in its life (D-070).
///
/// Exactly one DRAFT and one ACTIVE may exist per `key`, enforced by two partial
/// unique indexes the migration adds by hand — Prisma cannot express a `WHERE`
/// on a unique index, and a rule this important should be the database's rather
/// than a service's good intentions (the D-035 discipline).
///
/// RETIRED is not deletion. A retired version keeps every question and option a
/// past response points at, which is the whole mechanism behind D-049's promise
/// that results are frozen as taken.
enum AssessmentStatus {
  /// Being edited. Never served to a taker; freely editable, because no
  /// response can reference a draft's rows.
  DRAFT
  /// The version new takers receive.
  ACTIVE
  /// Superseded by a later version. Kept forever.
  RETIRED
}

/// One version of the assessment (§4C.3, D-069).
///
/// **Copy-on-write.** Editing never mutates a live bank: publishing an edit
/// inserts a *new* row at `version + 1` with its own copy of every question,
/// option and weight, and retires the previous one. `assessment_results` keep
/// pointing at the version they were scored against, and `Restrict` on that
/// relation means the instrument behind any result still exists — which is what
/// makes "frozen as taken" literally true rather than only true of the numbers.
///
/// So `key` is no longer unique on its own: several rows share `riasec-core` and
/// differ by version.
model Assessment {
  id String @id @default(uuid()) @db.Uuid

  /// Stable identifier for the *instrument*, shared by all its versions.
  key         String
  /// 1 for the seeded bank; each published edit is the next integer.
  version     Int    @default(1)
  title       String
  description String

  /// Which scorer, which bank tables, which result payload — the whole reason
  /// this table can hold more than the Holland assessment now (TAM-147).
  /// `RIASEC` for every row that predates this column (the seeded
  /// `riasec-core`); `english-cefr` (TAM-148) is the first `CEFR` row.
  kind AssessmentKind @default(RIASEC)

  status AssessmentStatus @default(DRAFT)

  /// When this version became the one new takers receive. Null while DRAFT —
  /// §4C.3 must show a version *and an effective date*, and a draft has no date
  /// because it is not in effect.
  effectiveFrom DateTime? @map("effective_from")
  /// When a later version superseded it. Null unless RETIRED.
  retiredAt     DateTime? @map("retired_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// The Holland bank — populated only for `kind: RIASEC` rows.
  questions AssessmentQuestion[]
  /// Every result taken against this version, of whichever `kind` it is —
  /// this relation, and this table, is what makes "what has this person
  /// taken" answerable without a union across instrument-specific tables.
  results AssessmentResult[]

  /// The CEFR item bank and its scoring bands — populated only for
  /// `kind: CEFR` rows (TAM-148's tables, repointed here by TAM-147). Kept
  /// separate from `questions` rather than folded into one shape: a Holland
  /// option's weight-per-dimension and a CEFR option's marks/correctness
  /// answer different questions, and a column that means one thing for one
  /// `kind` and something else for another is the exact confusion a
  /// discriminator on the *registry* is meant to avoid re-introducing further
  /// down.
  englishQuestions EnglishAssessmentQuestion[]
  englishBands     EnglishAssessmentBand[]

  @@unique([key, version])
  @@index([key, status])
  /// Every "the active assessment" read now filters on `kind` first — the
  /// query D-124 flagged as the reason a second instrument could not safely
  /// share this table without one.
  @@index([kind, status])
  @@map("assessments")
}

model AssessmentQuestion {
  id String @id @default(uuid()) @db.Uuid

  assessmentId String     @map("assessment_id") @db.Uuid
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  /// Stable across wording edits, so revising a question does not orphan the
  /// responses that reference it.
  key          String
  displayOrder Int    @map("display_order")
  text         String

  options   AssessmentOption[]
  responses AssessmentResponse[]

  @@unique([assessmentId, key])
  @@index([assessmentId, displayOrder])
  @@map("assessment_questions")
}

model AssessmentOption {
  id String @id @default(uuid()) @db.Uuid

  questionId String             @map("question_id") @db.Uuid
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  key          String
  displayOrder Int    @map("display_order")
  label        String

  weights   AssessmentOptionWeight[]
  responses AssessmentResponse[]

  @@unique([questionId, key])
  @@index([questionId, displayOrder])
  @@map("assessment_options")
}

/// What one option contributes to one dimension (§6: "store the dimension
/// weighting per option").
///
/// A table with an enum column rather than a JSON blob on the option. The
/// difference matters: a mistyped letter in JSON contributes nothing and fails
/// silently, producing a subtly wrong Holland Code that no error surfaces. Here
/// the database rejects it, and Phase 5's weight editor gets referential
/// integrity without writing validation for it.
model AssessmentOptionWeight {
  id String @id @default(uuid()) @db.Uuid

  optionId String           @map("option_id") @db.Uuid
  option   AssessmentOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  dimension RiasecDimension
  points    Int

  @@unique([optionId, dimension])
  @@map("assessment_option_weights")
}

/// One completed attempt, of whichever instrument it was (TAM-147).
///
/// **One table answers "what has this person taken"**, for every kind — a
/// second results table per instrument would split the journey in two and
/// leave nothing able to answer that question without a union. So the payload
/// is a nullable column group per `kind`, beside a `kind` column that says
/// which group is populated: the six Holland columns for a `RIASEC` row (all
/// six, not just the top three, so the ranking that orders gold
/// recommendations and the profile needed to re-explain the result later both
/// survive), `cefr_level`/`cefr_score`/`cefr_max` for a `CEFR` row. Exactly one
/// group is ever non-null on a given row — the scorer for that `kind` is what
/// populates it, and nothing here validates that at the schema level, the same
/// way `assessment_option_weights` trusts its own scorer.
model AssessmentResult {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assessmentId      String     @map("assessment_id") @db.Uuid
  assessment        Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  assessmentVersion Int        @map("assessment_version")

  /// Which payload group below is populated. Stored redundantly with
  /// `assessment.kind` (rather than read through the join) so "every
  /// instrument this person has taken" is one query over this table alone.
  kind AssessmentKind

  /// The Holland payload — populated only when `kind: RIASEC`. All six, as
  /// columns rather than JSON so they stay typed and queryable for the Phase 5
  /// oversight dashboards.
  scoreR Int? @map("score_r")
  scoreI Int? @map("score_i")
  scoreA Int? @map("score_a")
  scoreS Int? @map("score_s")
  scoreE Int? @map("score_e")
  scoreC Int? @map("score_c")

  /// The maximum a single dimension could attain in the version scored. Stored
  /// so a historical result can still be shown as a percentage after the bank
  /// changes size.
  maxScore Int?    @map("max_score")
  /// The derived Holland Code, e.g. "SIA".
  code     String? @db.VarChar(3)

  /// The CEFR payload (TAM-148's `EnglishAssessmentResult`, folded in by
  /// TAM-147) — populated only when `kind: CEFR`. `cefrMax` is the marks
  /// attainable in the version scored — the CEFR analogue of `maxScore` above,
  /// kept as its own column rather than reusing `maxScore` because the two
  /// numbers answer different questions (attainable *per dimension* vs.
  /// attainable *in total*) and a column that changes meaning by `kind` is
  /// exactly the ambiguity a discriminated table is meant to avoid.
  cefrLevel CefrLevel? @map("cefr_level")
  cefrScore Int?       @map("cefr_score")
  cefrMax   Int?       @map("cefr_max")

  completedAt DateTime @default(now()) @map("completed_at")

  responses        AssessmentResponse[]
  englishResponses EnglishAssessmentResponse[]

  /// Retakes append for `RIASEC` (D-033), so "the user's result" is the
  /// newest row of that kind. `CEFR` allows exactly one ever (D-123) — a
  /// database constraint, not an application check, because a unique index is
  /// what wins the race between two concurrent submissions and a service-level
  /// guard is not; see the hand-written partial index in the migration
  /// (`WHERE kind = 'CEFR'` — `@@unique` cannot express the `WHERE`, the same
  /// limitation `AssessmentStatus`'s DRAFT/ACTIVE index already works around).
  @@index([userId, completedAt])
  @@index([userId, kind, completedAt])
  @@map("assessment_results")
}

model AssessmentResponse {
  id String @id @default(uuid()) @db.Uuid

  resultId String           @map("result_id") @db.Uuid
  result   AssessmentResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  questionId String             @map("question_id") @db.Uuid
  /// Restrict, not Cascade: editing the bank in Phase 5 must not silently
  /// delete the answers people already gave.
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  optionId String           @map("option_id") @db.Uuid
  option   AssessmentOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  /// One answer per question per attempt — the database half of the rule the
  /// scoring engine also enforces.
  @@unique([resultId, questionId])
  @@map("assessment_responses")
}

/// The six levels of the Common European Framework, **ascending** (§4.13).
///
/// The order is a domain fact, not a presentation choice: a band table is
/// validated as a partition of the score range in this order, and a result is
/// rendered against it. `CEFR_LEVELS` in `@tamkeen/types` is the same list, and
/// the two must not drift.
enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

/// What an English item is testing (§4.13). Authoring metadata: it groups the
/// bank for whoever is revising it, and nothing in scoring reads it.
enum EnglishSkill {
  GRAMMAR
  VOCABULARY
  READING
  PRACTICAL
}

/// The CEFR item bank for one version of `Assessment` where `kind: CEFR`
/// (§4.13, §4C.9, D-123) — TAM-148's `EnglishAssessment` before TAM-147 folded
/// its registry row into `Assessment` itself.
///
/// **The bank stays its own shape; only the registry unified.** Holland tallies
/// six dimensions into a ranked code and has no notion of a right answer;
/// English sums marks for correct answers into a single ascending score and has
/// no notion of a dimension. Folding the *banks* into one shape would mean a
/// nullable column for every difference; `Assessment.kind` is what unified
/// instead — "which instruments exist" and "what did this person take" now
/// have one answer each, while a Holland option's weight-per-dimension and a
/// CEFR option's marks/correctness keep answering different questions in their
/// own tables, same as before.
///
/// **Copy-on-write, exactly as D-072 specifies it**, because D-049 applies here
/// unchanged: publishing an edit inserts a new `Assessment` row at
/// `version + 1` with its own questions, options *and bands*, and retires the
/// previous one. Results keep pointing at the version that scored them,
/// `Restrict` keeps that version alive, and the bands travel with it — so "38
/// out of 60 meant B2" stays true even after the ministry moves the B2
/// boundary.
model EnglishAssessmentQuestion {
  id String @id @default(uuid()) @db.Uuid

  assessmentId String     @map("assessment_id") @db.Uuid
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  /// Stable across wording edits, so revising an item does not orphan the
  /// responses that reference it (the D-032 rule, applied here).
  key          String
  displayOrder Int    @map("display_order")
  text         String

  /// **What a correct answer is worth — the concept Holland's model has no need
  /// for.** Holland's points live on the option because every option scores;
  /// here exactly one option scores and the rest score nothing, so the value
  /// belongs to the question. Putting it on the option instead would invite a
  /// bank where two options are worth different amounts of "correct".
  marks Int @default(1)

  /// The CEFR level this item targets and the skill it tests. Authoring
  /// metadata only: scoring never reads either. They exist so a thirty-item
  /// bank spanning A1-C2 can be reviewed and rebalanced by a human without
  /// re-reading every question.
  level CefrLevel
  skill EnglishSkill

  options   EnglishAssessmentOption[]
  responses EnglishAssessmentResponse[]

  @@unique([assessmentId, key])
  @@index([assessmentId, displayOrder])
  @@map("english_assessment_questions")
}

model EnglishAssessmentOption {
  id String @id @default(uuid()) @db.Uuid

  questionId String                    @map("question_id") @db.Uuid
  question   EnglishAssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  key          String
  displayOrder Int    @map("display_order")
  label        String

  /// The correct-answer concept. Exactly one option per question carries it —
  /// enforced at publish by `assessEnglishBank`, not by the schema, because a
  /// draft must be allowed to sit in an invalid state while it is being edited
  /// (the D-073 reasoning: a guard on every save makes the legal destination
  /// unreachable).
  isCorrect Boolean @default(false) @map("is_correct")

  responses EnglishAssessmentResponse[]

  @@unique([questionId, key])
  @@index([questionId, displayOrder])
  @@map("english_assessment_options")
}

/// One CEFR band of the version that owns it — the configurable scoring rule
/// (§4C.9).
///
/// **On the version, not in `settings`.** A band table is part of the
/// instrument: it is what turns a raw score into the level a person is told
/// they are. Held globally in `settings`, moving the B2 boundary would silently
/// re-interpret every result ever issued — the exact gap copy-on-write exists to
/// close (D-072). Held here, it is copied with the version and frozen with it.
///
/// Bounds are **inclusive at both ends**, and the set must partition `0 …
/// maxTotal` with no gap and no overlap (`assessEnglishBank`). Inclusive rather
/// than half-open because these are read and typed by a human: "45 to 56" is
/// what an administrator means, and a half-open editor would put an off-by-one
/// between what they typed and what a learner was told.
model EnglishAssessmentBand {
  id String @id @default(uuid()) @db.Uuid

  assessmentId String     @map("assessment_id") @db.Uuid
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  level    CefrLevel
  minScore Int       @map("min_score")
  maxScore Int       @map("max_score")

  @@unique([assessmentId, level])
  @@index([assessmentId, minScore])
  @@map("english_assessment_bands")
}

/// One CEFR attempt's answers. The result itself is a `kind: CEFR` row of the
/// unified `AssessmentResult` (TAM-147) — the total, what was attainable and
/// the band it fell in are `cefrScore`/`cefrMax`/`cefrLevel` there, not
/// repeated here. What stays here, unchanged from TAM-148, is the per-question
/// answer trail: stored only so a result can be re-explained (§3A), and
/// `Restrict` on both FKs for the D-035 reason — editing the bank must not
/// silently delete the answers people already gave and change a historical
/// result.
model EnglishAssessmentResponse {
  id String @id @default(uuid()) @db.Uuid

  resultId String           @map("result_id") @db.Uuid
  result   AssessmentResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  questionId String                    @map("question_id") @db.Uuid
  question   EnglishAssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  optionId String                  @map("option_id") @db.Uuid
  option   EnglishAssessmentOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@unique([resultId, questionId])
  @@map("english_assessment_responses")
}

/// Who an `AssessmentAssignment` or `AssessmentGroup` reaches (§4C.3, TAM-147).
enum AssignmentScope {
  /// Every employee. `target` is null.
  ALL
  /// Everyone in one department. `target` is the department name — the closed
  /// list the register form uses (`DEPARTMENTS`), not free text.
  DEPARTMENT
  /// One account. `target` is the user id.
  USER
}

/// A named, ordered bundle of instruments — "«الحزمة الأساسية» = Holland +
/// CEFR" as one assignable thing instead of two separate admin actions
/// (§4C.3, TAM-147).
///
/// **`memberKeys` is read live, never copied.** An assignment references a
/// group by `key`; resolving it walks `memberKeys` at read time, so editing a
/// group's membership changes what everyone assigned to it must take from
/// then on — the same "no snapshot" reasoning `path_courses` was built with.
/// A group holding no members, or a stale key nothing resolves, is a legal
/// state (an admin mid-edit); resolution simply drops what does not resolve
/// rather than erroring the whole assignment.
model AssessmentGroup {
  id String @id @default(uuid()) @db.Uuid

  /// Stable reference, the same role `Assessment.key` plays for one instrument
  /// — what an `AssessmentAssignment.assessmentKey` actually stores when it
  /// names a group rather than a single instrument.
  key  String @unique
  /// What an administrator sees — Arabic prose like "الحزمة الأساسية", never
  /// used as a reference so renaming it cannot break an assignment.
  name String

  /// Instrument keys, in the order §4C.3's tracker should show them once
  /// expanded. Not a join table: membership is authored as one ordered list,
  /// the same choice `paths.skill_outcomes` (TAM-150) made for a short,
  /// admin-edited list that never needs its own metadata per entry.
  memberKeys String[] @map("member_keys")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("assessment_groups")
}

/// One instrument or group, assigned to everyone / a department / a person
/// (§4C.3, TAM-147).
///
/// **An employee's effective list is a resolution, not a stored one**: the
/// union of every `ALL` row, every row targeting their department, and every
/// row targeting their account, ordered by `displayOrder` and de-duplicated by
/// the instrument key it resolves to (a group expands to its members first).
/// This table holds the rules an admin wrote, not the answer for any one
/// employee — the same relationship `path_courses` has to "which courses can
/// this learner pick," resolved fresh on every read rather than materialised
/// per user.
///
/// **`assessmentKey` names either an instrument or a group**, tried in that
/// order by whatever resolves it: `Assessment.key` (an ACTIVE instrument)
/// first, `AssessmentGroup.key` second. The two key spaces do not collide in
/// practice — instrument keys are the short English slugs `riasec-core` /
/// `english-cefr` are examples of, seeded once and never chosen by an admin
/// day-to-day, while a group is named at assignment time — but resolution
/// asserts the match is unambiguous rather than assuming it silently. A
/// dedicated `groupId` foreign key was considered and rejected: it would
/// still need `assessmentKey` beside it for the instrument case, so the
/// assignment would carry two "what" fields where at most one is ever set,
/// and a nullable FK is not a foreign key a `Restrict`/`Cascade` policy can
/// usefully name (an assignment outliving the instrument it names is exactly
/// as fine as one outliving the group it names — both simply resolve to
/// nothing and are skipped, never an error a learner would see).
model AssessmentAssignment {
  id String @id @default(uuid()) @db.Uuid

  assessmentKey String          @map("assessment_key")
  scope         AssignmentScope
  /// Null for ALL; a `DEPARTMENTS` entry for DEPARTMENT; a user id for USER.
  target        String?

  /// Whether §4.2's dashboard tracker must show this instrument before the
  /// journey can be called started, or it is offered without blocking
  /// anything (TAM-147 part 3's "a required instrument is untaken").
  required     Boolean @default(true)
  /// Where this instrument sits in the tracker, among every other assignment
  /// that resolves to the same employee.
  displayOrder Int     @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Not a hard uniqueness guarantee — `target` is null for every `ALL` row,
  /// and Postgres treats NULL as distinct from NULL in a unique index, so two
  /// `ALL` rows for the same key would not collide here. The admin service
  /// checks for that duplicate before creating one; this index is what makes
  /// that check, and every resolution read, an index scan rather than a
  /// table scan.
  @@index([assessmentKey, scope, target])
  @@index([scope, target])
  @@map("assessment_assignments")
}

/// A career path, tagged with exactly one primary RIASEC letter (§3A).
model Path {
  id String @id @default(uuid()) @db.Uuid

  key         String @unique
  name        String
  description String

  /// Three to five short noun phrases naming what the path produces — «تحليل
  /// البيانات الميدانية», never a sentence. Authored by the directorate
  /// alongside `description` (§4C.4, TAM-150); empty until they are.
  skillOutcomes String[] @default([]) @map("skill_outcomes")

  /// Drives the gold recommendation: a path is gold when this letter is in the
  /// user's top-three Holland Code.
  riasecLetter RiasecDimension @map("riasec_letter")

  typicalDurationMinutes Int? @map("typical_duration_minutes")

  /// Curated ordering *within* a recommendation group. Recommendation rank
  /// always outranks it.
  displayOrder Int     @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pathCourses  PathCourse[]
  userPaths    UserPath[]
  certificates Certificate[]

  @@index([riasecLetter])
  @@map("paths")
}

/// A thin mirror of an LMS course, plus the product metadata we layer on top
/// (§6). Content lives in the LMS and is never authored twice.
model Course {
  id String @id @default(uuid()) @db.Uuid

  /// The only bridge to the LMS for courses (§1). Unique so two rows can never
  /// mirror the same LMS course.
  moodleCourseId Int @unique @map("moodle_course_id")

  /// Cached from the LMS by the catalogue sync.
  title           String
  summary         String
  durationMinutes Int?   @map("duration_minutes")

  /// **Derived, not authored** (D-059). Recomputed by `effectiveCourseStatus`
  /// from `publication`, `lmsVisible`, `lmsPresent` and whether any learner
  /// holds the course. Nothing assigns it directly — every writer goes through
  /// that one function, so the sync job and an entity action cannot disagree
  /// about what a given combination means.
  status CourseStatus @default(DRAFT)

  /// **Ours** (D-059). The entity's publishing decision, which catalogue sync
  /// may read but must never write. A course created by an entity starts DRAFT;
  /// the 48 seeded courses and anything discovered in the LMS start PUBLISHED,
  /// because they predate the notion of a draft and were already in the
  /// catalogue.
  publication CoursePublication @default(DRAFT)

  /// Admin-only (TAM-141, §4C.5): a cross-cutting course («عامة») that appears in
  /// every path's build list without path_courses rows, carries no derived
  /// RIASEC letters, and is exempt from the membership cap and coherence rules.
  /// Entities can neither set nor clear it.
  isGeneral Boolean @default(false) @map("is_general")

  /// **The LMS's**, and the only two course fields sync may set besides title
  /// and summary. `lmsVisible` is Moodle's own visibility flag; `lmsPresent` is
  /// whether Moodle still returns the course at all. Two facts rather than one
  /// because they mean different things: a hidden course may reappear next week,
  /// a vanished one has been deleted, and only the second may lead to RETIRED.
  lmsVisible Boolean @default(true) @map("lms_visible")
  lmsPresent Boolean @default(true) @map("lms_present")

  /// Product metadata the LMS has no first-class field for, authored on our
  /// side and edited by entities (§4B.3, D-035). Deliberately not added to the
  /// LMS port: inventing a Moodle field for them would make the Phase 2 adapter
  /// responsible for data Moodle does not model.
  objectives    String[]
  prerequisites String?

  /// The single language this course was authored in (D-047). Nullable because
  /// a course discovered in the LMS has not been through an entity yet, and
  /// guessing from the characters in a title would be wrong often enough to
  /// matter. Publishing requires it to be set.
  language CourseLanguage?

  /// Which entity supplies this course (D-063). **Nullable**: the seeded
  /// catalogue and anything the LMS holds that no entity authored have no
  /// owner, which is a legitimate state — such a course is simply one no entity
  /// may manage, and the super-admin owns it in Phase 5.
  ownerEntityId String? @map("owner_entity_id") @db.Uuid
  ownerEntity   Entity? @relation(fields: [ownerEntityId], references: [id], onDelete: Restrict)

  /// The availability window the ministry sets from §4C.5 (TAM-134).
  ///
  /// **Both bounds are optional and mean "no bound".** A course with neither is
  /// available for as long as its publication and the LMS allow — which is every
  /// course that existed before this field, so adding it changed nothing about
  /// them.
  ///
  /// Stored as instants, set from calendar days in Arabia Standard Time by
  /// `availabilityWindowFrom`/`availabilityWindowUntil`: an administrator picks
  /// «حتى ٣٠ سبتمبر» and means the end of that day where they are, not 03:00 the
  /// following morning, which UTC midnight would have given them.
  ///
  /// The window is an *input to the status derivation*, never a status of its
  /// own (D-059) — `effectiveCourseStatus` is still the only thing that decides
  /// what a learner sees, so an expired window cannot contradict the publication
  /// decision or strand a learner who already holds the course.
  availableFrom  DateTime? @map("available_from")
  availableUntil DateTime? @map("available_until")

  lastSyncedAt DateTime? @map("last_synced_at")
  /// When the entity first published it. Kept for the entity dashboard and the
  /// audit trail; publication state itself lives in `publication`.
  publishedAt  DateTime? @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pathCourses     PathCourse[]
  userPathCourses UserPathCourse[]
  certificates    Certificate[]

  @@index([status])
  @@index([ownerEntityId])
  /// The availability refresh scans for a bound that has passed; without this it
  /// reads the whole catalogue every sync cycle.
  @@index([availableUntil])
  @@map("courses")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 4 — entities (the organisations that supply courses)
// ─────────────────────────────────────────────────────────────────────────────

/// An organisation that authors courses in the LMS and reviews its learners
/// (§4B, D-063).
///
/// **The organisation owns the courses, not the person who created them.**
/// Several accounts may belong to one entity, and hanging `courses.owner` off a
/// user id would orphan a catalogue the day that person leaves — which for a
/// ministry supplier is a routine event, not an edge case.
///
/// Deleting an entity is not modelled: `courses.ownerEntityId` is `Restrict`, so
/// an entity with courses cannot be removed. Suspension is the operational
/// answer, and it keeps the audit trail intact.
model Entity {
  id String @id @default(uuid()) @db.Uuid

  /// Stable identifier for seeding and idempotent re-seeding, as `Path.key` and
  /// `Assessment.key` already do.
  key String @unique

  name String

  /// A contact for the organisation, not a person's account. Kept minimal per
  /// §4B.6 — this is an address the ministry already has from procurement, not
  /// new PII collected from an individual.
  contactName  String @default("") @map("contact_name")
  contactEmail String @default("") @map("contact_email")

  status EntityStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users   User[]
  courses Course[]

  @@map("entities")
}

/// Paths ↔ courses. A course may belong to several paths (D-003), which is why
/// this is a join table rather than a `pathId` on `courses`.
/// Whether an entity's path membership has been accepted (TAM-141). Path
/// membership is path content the admin owns (§4C.4); what an entity saves is a
/// proposal. Only APPROVED rows reach the learner catalogue, path build, the
/// derived RIASEC letters and the publish gate. Auto-approved while
/// PATH_MEMBERSHIP_APPROVAL=off (until Phase 5's queue exists).
enum PathMembershipStatus {
  PENDING
  APPROVED
}

model PathCourse {
  id String @id @default(uuid()) @db.Uuid

  pathId String @map("path_id") @db.Uuid
  path   Path   @relation(fields: [pathId], references: [id], onDelete: Cascade)

  courseId String @map("course_id") @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  displayOrder Int @map("display_order")

  status      PathMembershipStatus @default(APPROVED)
  /// The admin who approved or will have rejected it; null when auto-approved.
  decidedById String?              @map("decided_by_id") @db.Uuid
  decidedAt   DateTime?            @map("decided_at")

  @@unique([pathId, courseId])
  @@index([pathId, displayOrder])
  @@map("path_courses")
}

/// The user's single chosen path (D-002).
///
/// `userId` is **unique**, so "one path per user" is a database constraint
/// rather than an application convention — a second path cannot be inserted even
/// by a bug or a concurrent request. Changing which path is being built before
/// confirmation updates this row; after confirmation nothing may change it.
model UserPath {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pathId String @map("path_id") @db.Uuid
  path   Path   @relation(fields: [pathId], references: [id], onDelete: Restrict)

  status UserPathStatus @default(BUILDING)

  /// Set once, at the hard commitment gate. Its presence is what locks the path
  /// and the assessment result (D-015).
  confirmedAt DateTime? @map("confirmed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  courses UserPathCourse[]

  @@map("user_paths")
}

/// The 5-10 courses the user selected, and their per-course state.
model UserPathCourse {
  id String @id @default(uuid()) @db.Uuid

  userPathId String   @map("user_path_id") @db.Uuid
  userPath   UserPath @relation(fields: [userPathId], references: [id], onDelete: Cascade)

  courseId String @map("course_id") @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  displayOrder Int                  @map("display_order")
  status       UserPathCourseStatus @default(NOT_STARTED)

  /// Raw grade mirrored from the LMS, 0-100. Never a pass/fail verdict — the
  /// threshold is a product setting (D-007) and issuing anything from it is
  /// Phase 3.
  gradePercent Int? @map("grade_percent")

  /// When the LMS enrolment was requested. A dedicated `enrollments` table is
  /// optional per §6; it earns its place in Phase 2, when sync debugging needs
  /// more than a timestamp.
  enrolledAt  DateTime? @map("enrolled_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Keyed on the course, so a course reachable through more than one route is
  /// never selected twice within a path.
  @@unique([userPathId, courseId])
  @@index([userPathId, displayOrder])
  @@map("user_path_courses")
}

/// Course completion, mirrored from the LMS (§6, Phase 2E).
///
/// **Unique on (user, moodle_course_id).** That single constraint carries three
/// separate rules. Re-running the sync cannot create a second row, so polling is
/// safe (D-005). A course reachable through more than one route reuses the one
/// completion rather than being re-taken (D-003, §2). And Phase 3's certificate
/// issuance gets a stable key to be idempotent against.
///
/// Keyed on `moodle_course_id` rather than our `courses.id` deliberately: the
/// LMS course is the thing actually completed, and a completion must survive our
/// catalogue row being retired or re-created.
model Completion {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  moodleCourseId Int @map("moodle_course_id")

  /// The LMS's own completion signal, and when its last criterion was met.
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")

  /// Course-total grade, 0-100. Null when nothing has been attempted — never 0,
  /// which would read as a failed attempt.
  gradePercent Int? @map("grade_percent")

  /// **Our** verdict, not the LMS's (D-007). Stored alongside the threshold it
  /// was judged against, so a later change to the product setting cannot make a
  /// historical pass unexplainable — which matters when a certificate was issued
  /// on the strength of it.
  passed            Boolean @default(false)
  passThresholdUsed Int?    @map("pass_threshold_used")

  /// When we last read this from the LMS. Distinct from `completedAt`, which is
  /// when the learner finished.
  syncedAt DateTime @map("synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, moodleCourseId])
  @@index([userId])
  @@map("completions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 3 — certificates
// ─────────────────────────────────────────────────────────────────────────────

/// What a certificate was issued for (§2). A course certificate is earned by
/// passing one course's quiz; the larger path certificate by passing every
/// course the user chose.
enum CertificateType {
  COURSE
  PATH
}

/// A credential issued by *us*, not by the LMS (D-006).
///
/// **Issuance is idempotent, and three separate mechanisms carry that.** The
/// service checks before issuing; the unique indexes below make a duplicate
/// impossible even under two concurrent sync runs; and the caller's transition
/// guard (D-042 §5) keeps the common case cheap. Only the middle one is a
/// guarantee — the completion sync polls forever, and anything that is merely
/// *usually* unique eventually is not.
///
/// **The printed values are stored, not joined.** `holderName` and
/// `subjectTitle` are copied in as they were rendered, because the PDF bytes
/// are immutable and everything they were built from is not: a person may
/// change their name, and catalogue sync rewrites `courses.title` from the LMS
/// on every run (D-040). Joining live rows would let the public verification
/// page contradict the certificate it is verifying — which is precisely the
/// thing a third party consults it to rule out.
model Certificate {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type CertificateType

  /// Exactly one of these is set, matching `type`. Prisma cannot express that,
  /// so a CHECK constraint in the migration does — a certificate for both a
  /// course and a path, or for neither, is not a state worth handling in code.
  /// `Restrict` on both: a course or path with issued certificates cannot be
  /// deleted out from under them (§2, D-015).
  courseId String? @map("course_id") @db.Uuid
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Restrict)

  pathId String? @map("path_id") @db.Uuid
  path   Path?   @relation(fields: [pathId], references: [id], onDelete: Restrict)

  /// The public handle (§2, D-016). 256 bits of CSPRNG from `generateToken`, so
  /// it cannot be guessed or enumerated, and stored **in the clear** — unlike
  /// session and auth tokens, which are hashed. The difference is deliberate:
  /// this is not a credential that authenticates anyone, it is the name of a
  /// public record, and the QR on the paper has to resolve to it.
  verificationId String @unique @map("verification_id")

  /// Rendered once at issue time and never again. Relative to CERT_STORAGE_DIR
  /// so the storage root can move without rewriting every row.
  pdfPath   String @map("pdf_path")
  /// Of the stored bytes, so corruption or tampering is detectable rather than
  /// merely unlikely.
  pdfSha256 String @map("pdf_sha256")
  pdfBytes  Int    @map("pdf_bytes")

  /// As printed on the certificate face. See the model comment.
  holderName   String @map("holder_name")
  subjectTitle String @map("subject_title")

  issuedAt DateTime @default(now()) @map("issued_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// One course certificate per user per course, and one path certificate per
  /// user per path. Two constraints rather than one because the target lives in
  /// two columns; each is inert for the type it does not describe, since
  /// Postgres treats NULLs as distinct.
  @@unique([userId, type, courseId])
  @@unique([userId, type, pathId])
  @@index([userId, issuedAt])
  @@map("certificates")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 3 — the CV builder
// ─────────────────────────────────────────────────────────────────────────────

/// The learner's CV, as they authored it (§4.11, §6, D-050).
///
/// **One row per user**, enforced by the unique `userId` — a person has one CV
/// here, and "no template zoo initially" (§4.11) means there is nothing a
/// second row would represent.
///
/// **The repeating sections are JSON, deliberately, and this is the one place
/// that is right.** Everywhere else in this schema the opposite call was made:
/// option weights are an enum-column table rather than a blob precisely so a
/// mistyped letter cannot fail silently (D-035). The difference is what the
/// data is *for*. Nothing queries across a learner's job history — it is
/// written whole, read whole, and rendered whole into one document — so a
/// normalised `cv_experience` table would buy joins nobody makes and cost the
/// reordering, partial edits and shape changes a CV form does constantly. §6
/// sanctions it explicitly ("structured JSON sections ok"); the shapes are
/// validated at the API boundary against the types in @tamkeen/types.
///
/// **What is absent matters more than what is here.** No certifications: those
/// are read from `certificates` at load time and never copied in, so a CV
/// cannot claim a credential the learner does not hold. Same for the name,
/// department and Holland code the system contributes.
model CvProfile {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Personal details as they should appear on the CV. Pre-filled from the
  /// account, then editable — a learner writing in English may want a Latin
  /// form of a name the ministry holds in Arabic.
  fullName   String @map("full_name")
  jobTitle   String @default("") @map("job_title")
  department String @default("")
  email      String @default("")
  phone      String @default("")
  summary    String @default("")

  /// `CvExperienceEntry[]`, `CvEducationEntry[]`, `string[]` and
  /// `CvExternalCertification[]` from @tamkeen/types.
  experience             Json @default("[]")
  education              Json @default("[]")
  skills                 Json @default("[]")
  externalCertifications Json @default("[]") @map("external_certifications")

  /// Whether to print the career-orientation line (§4.11). Hides the line, not
  /// the result — the assessment record is untouched either way.
  showCareerProfile Boolean @default(true) @map("show_career_profile")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cv_profiles")
}
