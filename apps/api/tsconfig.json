{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "declaration": true,
    "removeComments": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "strictBindCallApply": true,
    "noImplicitAny": true,
    /* Nest DI relies on decorator metadata; isolatedModules is fine but
       decorators + emitDecoratorMetadata need the classic transform. */
    "isolatedModules": false
  },
  /* `prisma` is included so the seed script is typechecked. It now creates the
     catalogue and the question bank rather than one admin row, and an untyped
     seed for a government system is a real gap. tsconfig.build.json excludes it
     again so the emitted layout stays dist/main.js. */
  "include": ["src/**/*.ts", "test/**/*.ts", "prisma/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
